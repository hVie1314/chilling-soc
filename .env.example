# ─────────────────────────────────────────────────────────────
# SOC AI Triage System – Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────

# --- Production (vLLM on GPU server) ---
# HF_TOKEN=hf_your_huggingface_token_here
# LLM_BASE_URL=http://llm-engine:8000/v1
# LLM_MODEL=fdtn-ai/Foundation-Sec-8B

# --- Development (Ollama on Windows host) ---
# Create the model first: ollama create Foundation-Sec-8B-local -f Modelfile
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=Foundation-Sec-8B-local

# --- Shared ---
QDRANT_HOST=vector-db
QDRANT_PORT=6333
COLLECTION_NAME=soc_knowledge_base
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# --- SQLite State Bridge ---
SQLITE_DB_PATH=/app/data/soc_triage.db

# --- Action Routing (placeholder URLs for SOAR / Case Management) ---
# WEBHOOK_URL=https://your-case-management.example.com/webhook
# SOAR_API_URL=https://your-soar.example.com/api/v1

# ─────────────────────────────────────────────────────────────
# Fushion Center Case Management Integration (integration.py)
# ─────────────────────────────────────────────────────────────
# URL backend Fushion Center:
#   Local dev   → http://localhost:3001
#   Docker      → http://backend:3001
#   LAN/Remote  → http://<IP_SERVER>:3001
FUSHION_API_URL=http://localhost:3001

# API Key (lấy từ Admin → API Keys → Generate Key)
# User gắn với key PHẢI có permission: manageCase
# CẢNH BÁO: Không commit giá trị thật vào version control!
FUSHION_API_KEY=your-api-key-here

# Tên Organization / Tenant (case-sensitive, phải tồn tại trong hệ thống)
# Sai tên → API trả về 404 "organisation does not exist"
TENANT_NAME=Default
